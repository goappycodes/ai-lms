# ---------------------------------------------------------------------------
# AI Veda LMS — backend configuration. Copy to .env.local and fill in.
# ---------------------------------------------------------------------------

# Postgres. Supabase is used ONLY as a managed Postgres host — no Supabase
# Auth, Storage, Realtime or PostgREST. We connect with the pg driver over a
# plain connection string, so moving to RDS, Neon or self-hosted Postgres
# later is a change to these five values and nothing else.
#
# Use the IPv4 pooler host from Database → Connect, NOT the IPv6-only direct
# host: aws-0-<region>.pooler.supabase.com, user postgres.<project-ref>.
# Port 5432 = session pooler (local). Port 6543 = transaction pooler (Vercel).
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_NAME=postgres

# Cloudflare R2 (zero-egress HLS delivery). Leave blank to encode into
# /public/hls and serve locally in development.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Where uploaded video originals are staged before encoding (default: ./data)
DATA_DIR=

# ---------------------------------------------------------------------------
# Sentry — error monitoring. Everything here is optional: with no DSN the SDK
# initialises into a no-op and the app runs exactly as before.
# ---------------------------------------------------------------------------
# The DSN is public by design (it only accepts events, it cannot read them).
NEXT_PUBLIC_SENTRY_DSN=
# Optional: overrides the DSN server-side if you want a separate project.
SENTRY_DSN=
# 'staging' or 'production'. Defaults to NODE_ENV.
NEXT_PUBLIC_SENTRY_ENV=
SENTRY_ENV=
# Performance tracing, 0-1. Left at 0: we want errors, not traces, and every
# trace is extra bytes on a student's mobile data.
NEXT_PUBLIC_SENTRY_TRACES_RATE=0
SENTRY_TRACES_RATE=0
# Source-map upload at build time. Without a token the build still succeeds,
# it just produces minified stack traces. Keep the token OUT of the browser.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Firebase — product analytics (D-09). Behaviour and playback quality only;
# progress and completion are read from Postgres, never from here.
# Wiring lands in P6-02; these are the values it will need.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
