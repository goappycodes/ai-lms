# ---------------------------------------------------------------------------
# AI Veda LMS — backend configuration
# Copy to .env.local and fill in. Everything works without R2 configured:
# the video pipeline falls back to encoding into /public/hls and serving locally.
# ---------------------------------------------------------------------------

# Cloudflare R2 (zero-egress HLS delivery — from the ai-lms experiment).
# Leave blank to use the local /public/hls fallback in development.
R2_ACCOUNT_ID=
# R2 → Manage R2 API Tokens → Create API token (Object Read & Write)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL of the bucket: the r2.dev URL, or (recommended) a custom
# domain for Cloudflare CDN caching. e.g. https://pub-xxxx.r2.dev
R2_PUBLIC_URL=

# Where uploaded originals + the SQLite DB live (default: ./data)
DATA_DIR=
