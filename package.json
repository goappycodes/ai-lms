{
  "name": "ai-veda-lms",
  "version": "0.1.0",
  "private": true,
  "description": "AI Veda — Phase 0 LMS screen scaffold. Powered by NEXIS, in partnership with the Government of Kerala.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:migrate": "node scripts/migrate.mjs",
    "db:migrate:dry": "node scripts/migrate.mjs --dry-run",
    "db:status": "node scripts/migrate.mjs --status",
    "db:verify": "node scripts/db-verify.mjs",
    "db:smoke": "node scripts/db-smoke.mjs",
    "verify:password": "node --no-warnings scripts/verify-password.ts",
    "verify:auth": "node scripts/verify-auth.mjs",
    "users:create": "node --no-warnings --env-file=.env.local scripts/create-users.ts",
    "verify": "tsc --noEmit && next build && npm run db:smoke && npm run verify:password"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1103.0",
    "@sentry/nextjs": "^10.73.0",
    "next": "^14.2.35",
    "pg": "^8.22.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.4",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "typescript": "5.5.3"
  }
}
